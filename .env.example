# Claude
ANTHROPIC_API_KEY=
# Model used to read menus. Default claude-opus-5-5. See docs/research.md §5 for cost per model.
MENU_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
MENU_EFFORT=medium

# Supabase (new Code 85 Labs project; not wired in the MVP yet — drafts live in localStorage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Stripe (one account, owned by Code 85 Labs). Use TEST mode keys (sk_test_...) until launch.
# Payments are enforced only when BILLING_ENABLED=true AND STRIPE_SECRET_KEY is set.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
# Signing secret for <site>/api/stripe/webhook (Dashboard → Developers → Webhooks)
STRIPE_WEBHOOK_SECRET=
# Price IDs from the Stripe Dashboard. Never hard-code these.
# One-time $49 Price for a single menu build (falls back to an inline $49 line item if empty)
STRIPE_PRICE_PER_MENU=
# Recurring $149/month Price for Pro. Pro checkout only turns on when this is set.
STRIPE_PRICE_SUBSCRIPTION=

# Own-website link import. Off until SSRF guard + robots.txt check land.
LINK_FETCH_ENABLED=false

# Private beta password for /build and /api (Basic auth, any username).
# Launch: remove SITE_PASSWORD and set PUBLIC_APP=true.
SITE_PASSWORD=
PUBLIC_APP=false
# Menu reads allowed per IP per hour (best-effort)
EXTRACT_LIMIT_PER_HOUR=8

# Public site settings
# App domain (fastposmenu.com planned; .food still open)
NEXT_PUBLIC_SITE_URL=https://fastposmenu.com
# Code 85 Labs (parent company / seller)
NEXT_PUBLIC_COMPANY_URL=https://code85.app
NEXT_PUBLIC_SUPPORT_EMAIL=support@code85labs.com
NEXT_PUBLIC_BILLING_EMAIL=billing@code85labs.com
